{
  "name": "mtg-deck-builder",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace server",
    "prod": "powershell -ExecutionPolicy Bypass -File ./scripts/run-production.ps1",
    "pull-card-info": "powershell -ExecutionPolicy Bypass -File ./scripts/pull-cards.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}